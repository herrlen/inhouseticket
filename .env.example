# Copy to .env and adjust. Never commit .env.

# Postgres (docker compose: port 5442)
DATABASE_URL=postgres://inhouseticket:inhouseticket@localhost:5442/inhouseticket

# Public address of the app: sign-in, workspaces, API, MCP, links in mails.
# Production: https://app.inhouseticket.com – local: http://localhost:3100
APP_URL=https://app.inhouseticket.com
# Marketing address (landing and legal pages), same container. When its host differs from the
# APP_URL host, sign-in and app paths there redirect (301) to APP_URL and the session cookie is
# shared by both (Domain=inhouseticket.com). Leave empty locally: everything runs on APP_URL.
SITE_URL=https://inhouseticket.com

# Better Auth (Sprint 1) – generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-random-32-byte-secret

# SMTP for magic links. Local: Mailpit (UI at http://localhost:8025).
# Production: mittwald mailbox – host, port and credentials from mStudio.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="inhouseticket <no-reply@inhouseticket.com>"
# Replies to invitations and login mails go to a human.
MAIL_REPLY_TO=hello@inhouseticket.com

# Closed beta: only these company domains may sign up (comma-separated). Empty = open.
BETA_ALLOWED_DOMAINS=
# Platform operators (comma-separated): /admin, may sign in with a freemail address.
SUPERADMIN_EMAILS=
# Individual testers (comma-separated): may sign in despite freemail block and closed beta, no admin rights.
TESTER_EMAILS=
