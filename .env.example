# Copy to .env and adjust. Never commit .env.

# Postgres (docker compose: port 5442)
DATABASE_URL=postgres://inhouseticket:inhouseticket@localhost:5442/inhouseticket

# Public base URL of the app
APP_URL=http://localhost:3100

# Better Auth (Sprint 1) – generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-random-32-byte-secret

# SMTP for magic links. Local: Mailpit (UI at http://localhost:8025).
# Production: mittwald mailbox – host, port and credentials from mStudio.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="inhouseticket <no-reply@inhouseticket.com>"
