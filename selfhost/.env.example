# inhouseticket – Einstellungen der eigenen Instanz (docs/selbst-hosten.md).
#
# install.sh legt daraus .env an (Rechte 600, nur root lesbar) und erzeugt die Geheimnisse selbst.
# Von Hand ändern geht auch: danach `docker compose up -d` im selben Ordner.
# Werte in einfachen Anführungszeichen, ohne einfache Anführungszeichen darin.
#
# .env NIE weitergeben und nie in ein Git-Repository legen. Eine Kopie gehört in den
# Passwort-Manager – ohne BETTER_AUTH_SECRET und INTEGRATION_SECRET ist ein Backup nur halb nutzbar.

# ── Adresse ──────────────────────────────────────────────────────────────────────────────────────
# Subdomain, unter der inhouseticket läuft (ohne https://). Der DNS-Eintrag (A/AAAA) muss auf
# diesen Server zeigen, sonst bekommt Caddy kein Zertifikat.
DOMAIN='tickets.firma.de'
# E-Mail für Let's Encrypt (Warnungen zu Zertifikaten). Meist dieselbe wie die Admin-Adresse.
ACME_EMAIL='it@firma.de'

# ── Version ──────────────────────────────────────────────────────────────────────────────────────
# Image aus der GitHub Container Registry. "main" = neueste geprüfte Version; für feste Stände
# "sha-<40 Zeichen Commit>" eintragen. update.sh setzt den Wert.
IMAGE_TAG='main'
# Nur ändern, wenn das Image woanders liegt.
# IMAGE='ghcr.io/herrlen/inhouseticket'

# ── Firma ────────────────────────────────────────────────────────────────────────────────────────
# Nur Adressen dieser Domains dürfen sich registrieren (Komma-getrennt, ohne @). Eingeladene
# Personen mit anderen Firmen-Adressen kommen trotzdem hinein. Gmail, GMX & Co. sind immer gesperrt.
BETA_ALLOWED_DOMAINS='firma.de'
# Betreiber dieser Instanz (Komma-getrennt): Zugang zu /admin (Kennzahlen, Version, IP-Prüfung).
SUPERADMIN_EMAILS='it@firma.de'
# Einzelne Ausnahmen (Komma-getrennt), die sich trotz Domain-Sperre registrieren dürfen – meist leer.
TESTER_EMAILS=''
# Name der Firma für den Hinweis „Diese Instanz wird von … betrieben“ (optional).
INSTANCE_NAME='Firma GmbH'
# Impressum und Datenschutzerklärung der Firma (optional). Gesetzt: die Links in der App führen
# direkt dorthin. Leer: ein neutraler Hinweis, dass die Firma die Instanz betreibt.
IMPRINT_URL='https://www.firma.de/impressum'
PRIVACY_URL='https://www.firma.de/datenschutz'

# ── E-Mail (SMTP) ────────────────────────────────────────────────────────────────────────────────
# Postfach der Firma für Anmeldelinks, Einladungen und die tägliche Zusammenfassung.
# Port 587 = STARTTLS (Standard), 465 = TLS. Unverschlüsselt geht nicht.
SMTP_HOST='smtp.firma.de'
SMTP_PORT='587'
SMTP_USER='tickets@firma.de'
SMTP_PASSWORD='…'
# Absender – muss zum Postfach passen, sonst landen Mails im Spam.
MAIL_FROM='inhouseticket <tickets@firma.de>'
# Antworten auf Mails gehen hierhin (optional).
MAIL_REPLY_TO='it@firma.de'

# ── Geheimnisse ─ erzeugt install.sh, nie ändern ────────────────────────────────────────────────
# Datenbank-Passwort (hex). Ändern nur zusammen mit dem Passwort in PostgreSQL selbst.
POSTGRES_PASSWORD=''
# Signiert Sitzungen. Ändern meldet alle ab.
BETTER_AUTH_SECRET=''
# Verschlüsselt gespeicherte Zugangsdaten (ClickUp-Token). Ändern macht sie unlesbar – dann muss
# der ClickUp-Token neu eingetragen werden.
INTEGRATION_SECRET=''
